# Copy these into Vercel → Project → Settings → Environment Variables.
# NEVER commit a real .env file.

# Google Cloud key used ONLY by /api/places (server side). Enable: Geocoding API + Places API (New).
GOOGLE_MAPS_API_KEY=your-google-key-here

# Optional: comma-separated origins allowed to call your API
ALLOWED_ORIGINS=https://www.cridaa.example,https://cridaa.example
# Optional: AI judge for ambiguous venues (shop/stadium filter). Leave empty to use rules only.
ANTHROPIC_API_KEY=
# Optional: set to off to disable venue filtering
VENUE_FILTER=
# Optional: country bias for geocoding/search (default IN)
DEFAULT_REGION=IN

# Lead capture — configure at least one:
# (A) Google Sheet via Apps Script web-app
LEAD_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
LEAD_WEBHOOK_SECRET=long-random-string
# (B) Web3Forms
WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
